DATABASE_URL=postgresql://user:password@localhost:5432/insight_b2b
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Obligatorio. Generar con: openssl rand -base64 48
# Firmar los JWT de sesion. Rotarlo invalida todos los tokens emitidos.
JWT_SECRET=cambiar_esto_en_produccion

# Mercado Público: ticket de la API pública (obligatorio en producción).
# En desarrollo lo inyecta el proxy de Vite; en producción este backend actúa
# como proxy (ver backend/src/routes/mercadopublico.ts).
MERCADO_PUBLICO_TICKET=cambiar_esto_en_produccion

# Email (opcional; sin SMTP_HOST las notificaciones quedan solo in-app)
SMTP_HOST=smtp.tudominio.cl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tudominio.cl
SMTP_PASS=tu_password
SMTP_FROM=insightB2B <no-reply@tudominio.cl>

